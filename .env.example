# Never expose this value through VITE_* variables or commit it.
PAYCREST_API_KEY=
PAYCREST_API_BASE=https://api.paycrest.io
PAYCREST_REFERENCE_PREFIX=kudiroll-
PAYCREST_REQUEST_TIMEOUT_MS=15000

# Live order creation is denied unless explicitly enabled.
PHASE0_LIVE_ORDER_ENABLED=false
PHASE0_MAX_NGN=5000
PORT=4173
HOST=127.0.0.1
STARKNET_RPC_URL=
STRK20_POOL_ADDRESS=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
KUDIROLL_DATA_FILE=.data/kudiroll.json
KUDIROLL_AUTH_BACKEND=file
KUDIROLL_ACCOUNT_BACKEND=file
# KUDIROLL_IMPORT_FILE_ON_EMPTY=true
# Set only after provisioning PostgreSQL and running npm run db:migrate.
# KUDIROLL_DATABASE_URL=postgresql://user:password@host:5432/database
# KUDIROLL_DATABASE_POOL_SIZE=5
# Required before importing or enabling PostgreSQL account storage. Generate and store outside source control.
# KUDIROLL_DATA_ENCRYPTION_KEY=<canonical-base64url-encoded-32-byte-key>
KUDIROLL_AUTH_FILE=.data/kudiroll-auth.json
KUDIROLL_WEBAUTHN_ORIGIN=http://localhost:4173
KUDIROLL_WEBAUTHN_RP_ID=localhost
RESEND_API_KEY=
KUDIROLL_EMAIL_FROM=KudiRoll <security@example.com>
KUDIROLL_EMAIL_CODE_SECRET=
KUDIROLL_RELEASE_SHA=development
